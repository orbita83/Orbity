{
  "expo": {
    "name": "Orbity",
    "slug": "orbity",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/app/icon/icon.png",
    "scheme": "orbity",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "io.github.orbita83.orbity",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#030417",
        "foregroundImage": "./assets/app/icon/adaptive-foreground.png",
        "monochromeImage": "./assets/app/icon/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/app/splash/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "df3e816f-9b5e-402f-ac46-f7c254a5132b"
      }
    },
    "owner": "mailsons"
  }
}
